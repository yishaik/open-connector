{
  "name": "open-connector-console",
  "main": "worker.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist/web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page",
  },
  "services": [
    {
      "binding": "ORIGIN",
      "service": "open-connector",
    },
  ],
}
