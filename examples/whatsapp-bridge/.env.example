# Copy to .env and chmod 600. Generate distinct random secrets (openssl rand -hex 32).
WA_RUNTIME_TOKEN=
WA_ADMIN_TOKEN=
# Exact JIDs, comma-separated. Empty means no chat access.
WA_ALLOWED_CHATS=
WA_ENABLE_SEND=false
# Existing dm-crypt-backed directory, owned by UID/GID 10001.
WA_HOST_DATA_DIR=/srv/whatsapp-encrypted/data
